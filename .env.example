# Backend API URL
# After deploying the CDK stack, update this with your API Gateway URL
# Example: VITE_API_URL=https://abc123.execute-api.us-east-1.amazonaws.com/prod

# For local development (if backend is running locally)
VITE_API_URL=http://localhost:3000

# For production (update after CDK deployment)
# VITE_API_URL=https://your-api-id.execute-api.region.amazonaws.com/prod

# Public site origin for social-preview and canonical tags
VITE_SITE_URL=https://master.d12ua58fdpbtag.amplifyapp.com

# --- Archive and special puzzles (branch feat/recap-archive-packs) ---
# Off unless set to "true". Keep it off anywhere the feature should not be visible.
VITE_FEATURE_ARCHIVE=false
# Stand-in sign-in code for test builds. Not security: anything in a browser bundle is visible.
VITE_TEST_ACCESS_CODE=cluelux-test-2026
# Dev builds only: "local" uses bundled sample days instead of the backend.
# VITE_ARCHIVE_SOURCE=local
